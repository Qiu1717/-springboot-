# ===== 数据库 =====
# 本地默认即可，修改为你的实际配置
DB_URL=jdbc:mysql://localhost:3306/course_selection?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 邮件（教师忘记密码时向管理员发申请邮件）=====
# QQ邮箱需在「设置 → 账户 → POP3/SMTP服务」中获取授权码，不是QQ密码
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code
# 接收教师密码重置申请的管理员邮箱
MAIL_ADMIN_EMAIL=admin@example.com

# ===== RabbitMQ（异步发送邮件）=====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===== JWT 密钥（生产环境必须改，长度不少于32位）=====
JWT_SECRET=course-selection-system-jwt-secret-please-override-in-production

# ===== AI 对话（DeepSeek，不配置则AI功能不可用）=====
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# ===== 其他 =====
SERVER_PORT=8080
# 建议使用相对路径，默认为项目根目录下的 uploads/ 与 downloads/
FILE_UPLOAD_DIR=./uploads
FILE_DOWNLOAD_DIR=./downloads
