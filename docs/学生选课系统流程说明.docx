### 数据表说明

```sql
-- 用户表（role: 0管理员 / 1教师 / 2学生）
CREATE TABLE user (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) UNIQUE,
    password VARCHAR(100),
    real_name VARCHAR(50),
    email VARCHAR(100),
    role INT  -- 0管理员 1教师 2学生
);

-- 课程表
CREATE TABLE course (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    credit FLOAT,
    term VARCHAR(20),
    schedule VARCHAR(100),  -- 如"周一 1-2节 机房A101"
    teacher_id INT,
    selected INT DEFAULT 0,  -- 已选人数
    capacity INT,            -- 容量上限
    status INT DEFAULT 1     -- 1启用 0停用
);

-- 选课记录表（含成绩）
CREATE TABLE selection (
    id INT PRIMARY KEY AUTO_INCREMENT,
    student_id INT,
    course_id INT,
    score FLOAT DEFAULT NULL,  -- NULL=未出分
    select_time DATETIME,
    UNIQUE KEY uk_student_course (student_id, course_id)  -- 防重复选课
);
```

